[Unit]
Description=Schedule network crawl at noon and evening

[Timer]
# Replace <SCHEDULE_TIMEZONE> with the same value as .env SCHEDULE_TIMEZONE.
Timezone=<SCHEDULE_TIMEZONE>
OnCalendar=*-*-* 12:00:00
OnCalendar=*-*-* 18:00:00
Persistent=true
Unit=network-crawl.service

[Install]
WantedBy=timers.target
